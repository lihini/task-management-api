{
    "openapi": "3.0.3",
    "info": {
      "title": "Task Management API",
      "description": "A RESTful API for managing tasks with AWS DynamoDB and S3 integration.",
      "version": "1.0.0",
      "contact": {
        "name": "API Support",
        "email": "support@example.com"
      }
    },
    "servers": [
      {
        "url": "http://localhost:3000",
        "description": "Local development server"
      }
    ],
    "paths": {
      "/tasks": {
        "post": {
          "summary": "Create a new task",
          "description": "Creates a new task with optional file uploads.",
          "tags": ["Tasks"],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTaskRequest"
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Task created successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/UpdatedTask"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid request data",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ValidationErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            }
          }
        },
        "get": {
          "summary": "Get all tasks",
          "description": "Retrieves a list of all tasks from DynamoDB.",
          "tags": ["Tasks"],
          "responses": {
            "200": {
              "description": "List of tasks",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "tasks": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Task"
                        }
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/tasks/{id}": {
        "get": {
          "summary": "Get a task by ID",
          "description": "Retrieves a specific task by its UUID from DynamoDB.",
          "tags": ["Tasks"],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "UUID of the task",
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Task retrieved successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            },
            "404": {
              "description": "Task not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid task ID",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ValidationErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            }
          }
        },
        "put": {
          "summary": "Update a task",
          "description": "Updates an existing task by its UUID with optional file uploads.",
          "tags": ["Tasks"],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "UUID of the task",
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateTaskRequest"
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Task updated successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/UpdatedTask"
                  }
                }
              }
            },
            "404": {
              "description": "Task not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid request data or task ID",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ValidationErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            }
          }
        },
        "delete": {
          "summary": "Delete a task",
          "description": "Deletes a task and its associated S3 files by its UUID.",
          "tags": ["Tasks"],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "required": true,
              "description": "UUID of the task",
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          ],
          "responses": {
            "204": {
              "description": "Task deleted successfully"
            },
            "404": {
              "description": "Task not found",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            },
            "400": {
              "description": "Invalid task ID",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/ValidationErrorResponse"
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/GenericErrorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "/users": {
        "get": {
          "summary": "Get users from external API",
          "description": "Fetches user data from JSONPlaceholder with 5-minute caching.",
          "tags": ["Users"],
          "responses": {
            "200": {
              "description": "List of users",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "users": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/ExternalUser" }
                      }
                    }
                  }
                }
              }
            },
            "502": {
              "description": "External API error",
              "content": {
                "application/json": {
                  "schema": { "$ref": "#/components/schemas/GenericErrorResponse" }
                }
              }
            },
            "500": { "$ref": "#/components/responses/ServerError" }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "Task": {
          "type": "object",
          "required": ["id", "title", "description", "status", "createdAt", "updatedAt"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Unique identifier for the task"
            },
            "title": {
              "type": "string",
              "description": "Title of the task"
            },
            "description": {
              "type": "string",
              "description": "Detailed description of the task"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "in-progress", "completed"],
              "description": "Current status of the task"
            },
            "fileUrls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the task was created"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the task was last updated"
            }
          },
          "example": {
            "id": "123e4567-e89b-12d3-a456-426614174000",
            "title": "Complete project proposal",
            "description": "Draft and finalize the project proposal for client review.",
            "status": "pending",
            "fileUrls": ["https://s3-bucket/task-uuid/filename"],
            "createdAt": "2025-04-12T10:00:00Z",
            "updatedAt": "2025-04-12T10:00:00Z"
          }
        },
        "UpdatedTask": {
          "type": "object",
          "required": ["id", "title", "description", "status", "createdAt", "updatedAt"],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "description": "Unique identifier for the task"
            },
            "title": {
              "type": "string",
              "description": "Title of the task"
            },
            "description": {
              "type": "string",
              "description": "Detailed description of the task"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "in-progress", "completed"],
              "description": "Current status of the task"
            },
            "fileUrls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the task was created"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "description": "Timestamp when the task was last updated"
            },
            "uploadUrls": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "example": {
            "id": "123e4567-e89b-12d3-a456-426614174000",
            "title": "Complete project proposal",
            "description": "Draft and finalize the project proposal for client review.",
            "status": "pending",
            "fileUrls": ["https://s3-bucket/task-uuid/filename"],
            "uploadUrls": ["pre-signed-s3-url-to-upload-file"],
            "createdAt": "2025-04-12T10:00:00Z",
            "updatedAt": "2025-04-12T10:00:00Z"
          }
        },
        "ExternalUser": {
          "type": "object",
          "required": ["id", "name", "username", "email"],
          "properties": {
            "id": { "type": "integer" },
            "name": { "type": "string" },
            "username": { "type": "string" },
            "email": { "type": "string", "format": "email" },
            "address": {
              "type": "object",
              "properties": {
                "street": { "type": "string" },
                "suite": { "type": "string" },
                "city": { "type": "string" },
                "zipcode": { "type": "string" },
                "geo": {
                  "type": "object",
                  "properties": {
                    "lat": { "type": "string" },
                    "lng": { "type": "string" }
                  }
                }
              }
            },
            "phone": { "type": "string" },
            "website": { "type": "string" },
            "company": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "catchPhrase": { "type": "string" },
                "bs": { "type": "string" }
              }
            }
          },
          "example": {
            "id": 1,
            "name": "Leanne Graham",
            "username": "Bret",
            "email": "Sincere@april.biz",
            "address": {
              "street": "Kulas Light",
              "suite": "Apt. 556",
              "city": "Gwenborough",
              "zipcode": "92998-3874",
              "geo": { "lat": "-37.3159", "lng": "81.1496" }
            },
            "phone": "1-770-736-8031 x56442",
            "website": "hildegard.org",
            "company": {
              "name": "Romaguera-Crona",
              "catchPhrase": "Multi-layered client-server neural-net",
              "bs": "harness real-time e-markets"
            }
          }
        },
        "CreateTaskRequest": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": {
              "type": "string",
              "description": "Title of the task"
            },
            "description": {
              "type": "string",
              "description": "Detailed description of the task"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "in-progress", "completed"],
              "description": "Initial status of the task (defaults to 'pending' if not provided)"
            },
            "fileNames": {
              "type": "array",
              "description": "Attachment names to be uploaded under the task",
              "items": {
                "type": "string",
                "description": "file name"
              }
            }
          },
          "example": {
            "title": "Complete project proposal",
            "description": "Draft and finalize the project proposal for client review.",
            "status": "pending",
            "fileNames": ["file1.txt", "file2.txt"]
          }
        },
        "UpdateTaskRequest": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Updated title of the task"
            },
            "description": {
              "type": "string",
              "description": "Updated description of the task"
            },
            "status": {
              "type": "string",
              "enum": ["pending", "in-progress", "completed"],
              "description": "Updated status of the task"
            },
            "fileNames": {
              "type": "array",
              "description": "Attachment names to be uploaded under the task",
              "items": {
                "type": "string",
                "description": "file name"
              }
            }
          },
          "example": {
            "title": "Revised project proposal",
            "description": "Incorporate feedback and finalize the proposal.",
            "status": "in-progress",
            "fileNames": ["file1.txt", "file2.txt"]
          }
        },
        "ValidationErrorResponse": {
          "type": "object",
          "properties": {
            "status": {
                "type": "number",
                "description": "HTTP status code"
            },
            "message": {
              "type": "string",
              "description": "Error message describing the issue"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "msg": {
                    "type": "string",
                    "description": "Validation error message"
                  },
                  "param": {
                    "type": "string",
                    "description": "Field that caused the error"
                  },
                  "location": {
                    "type": "string",
                    "description": "Location of the field (e.g., body, query)"
                  }
                }
              },
              "description": "Detailed validation errors (if applicable)"
            }
          },
          "example": {
            "message": "Invalid request data",
            "errors": [
              {
                "msg": "Title is required",
                "param": "title",
                "location": "body"
              }
            ]
          }
        },
        "GenericErrorResponse": {
          "type": "object",
          "properties": {
            "status": {
                "type": "number",
                "description": "HTTP status code"
            },
            "error": {
              "type": "object",
              "properties": {
                "message": {
                    "type": "string",
                    "description": "Error message describing the issue"
                },
                "type": {
                    "type": "string",
                    "description": "Error instance type"
                },
                "code": {
                    "type": "number",
                    "description": "Application specific error code"
                }
              },
              "description": "Detailed error messages (if applicable)"
            }
          },
          "example": {
            "status": 500,
            "error": {
              "message": "Task operation failed",
              "type": "InternalServerError",
              "code": 10500
            }
          }
        }
      },
      "responses": {
        "BadRequest": {
          "description": "Invalid request data",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" }
            }
          }
        },
        "NotFound": {
          "description": "Task not found",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenericErrorResponse" },
              "example": {
                "status": 404,
                "error": {
                  "message": "Task not found",
                  "type": "NotFoundError",
                  "code": 10404
                }
              }
            }
          }
        },
        "ServerError": {
          "description": "Internal server error",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GenericErrorResponse" },
              "example": {
                "status": 500,
                "error": {
                  "message": "Task operation failed",
                  "type": "InternalServerError",
                  "code": 10500
                }
              }
            }
          }
        }
      }
    },
    "tags": [
      { "name": "Tasks", "description": "Operations related to task management" },
      { "name": "Users", "description": "Operations related to external user data" }
    ]
  }